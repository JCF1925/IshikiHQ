{
  "name": "@workspace/syntropic",
  "private": true,
  "scripts": {
    "dev": "bash scripts/run-web-with-worker.sh dev",
    "build": "pnpm run prisma:generate && next build",
    "start": "bash scripts/run-web-with-worker.sh start",
    "calendar:worker": "tsx --require dotenv/config scripts/calendar-worker.ts",
    "redbark:worker": "tsx --require dotenv/config scripts/redbark-worker.ts",
    "ops:backup": "bash scripts/backup-database.sh",
    "ops:restore-drill": "bash scripts/restore-database-drill.sh",
    "ops:alert-test": "tsx --require dotenv/config scripts/synthetic-alert.ts",
    "ops:remind-evidence": "tsx --require dotenv/config scripts/remind-production-ops-evidence.ts",
    "ops:check-health-claims": "tsx --require dotenv/config scripts/check-health-claim-import-ownership.ts",
    "ops:verify-production": "bash scripts/verify-production-ops.sh",
    "release:smoke": "node scripts/release-web-smoke.mjs",
    "acceptance:database": "pnpm run prisma:generate && bash scripts/clean-database-acceptance.sh",
    "test:acceptance-interruption:preflight": "bash scripts/test-database-acceptance-interruption-preflight.sh",
    "test:acceptance-interruption:database": "pnpm run test:acceptance-interruption:preflight && bash scripts/test-clean-database-acceptance-interruption.sh",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm run prisma:generate && pnpm exec next typegen && tsc --noEmit",
    "test": "node scripts/run-deterministic-tests.mjs",
    "test:lint-release": "node scripts/test-lint-release-contract.mjs",
    "test:medication-stock:database": "bash scripts/run-medication-stock-acceptance.sh",
    "test:medication-stock:release": "bash scripts/verify-medication-stock-acceptance.sh",
    "test:medication-stock:release:regression": "bash scripts/test-medication-stock-acceptance.sh",
    "test:medication-stock:wrapper": "bash scripts/test-medication-stock-acceptance.sh",
    "test:database-target:wrapper": "bash scripts/test-database-acceptance-target.sh",
    "test:price-watch:database": "DATABASE_ACCEPTANCE_FOCUS=price-watches bash scripts/clean-database-acceptance.sh",
    "test:calendar-connections:database": "DATABASE_ACCEPTANCE_FOCUS=calendar-connections bash scripts/clean-database-acceptance.sh",
    "test:mobile-api:database": "bash scripts/run-mobile-api-acceptance.sh",
    "test:mobile-api:wrapper": "bash scripts/test-mobile-api-acceptance.sh",
    "test:auth-google": "tsx --test tests/google-auth-recovery.test.ts",
    "test:auth-google:wrapper": "bash scripts/test-google-auth-regression.sh",
    "test:auth-google:evidence-release": "bash scripts/verify-google-auth-staging-evidence.sh",
    "test:auth-google:evidence-wrapper": "bash scripts/test-google-auth-staging-evidence.sh",
    "test:calendar-google:wrapper": "bash scripts/test-google-calendar-live-acceptance.sh",
    "test:ops:verification": "tsx --test tests/production-ops-verification.test.ts",
    "test:accessibility": "playwright test",
    "test:accessibility:acceptance": "bash scripts/run-dashboard-release-gate.sh",
    "test:auth-google:release": "bash scripts/run-google-auth-regression.sh",
    "test:auth-google:staging": "bash scripts/run-google-auth-regression.sh staging",
    "test:calendar-google:live": "bash scripts/run-google-calendar-live-acceptance.sh",
    "prisma:generate": "prisma generate",
    "prisma:generate:release": "bash scripts/verify-prisma-generate.sh",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx --require dotenv/config scripts/safe-seed.ts"
  },

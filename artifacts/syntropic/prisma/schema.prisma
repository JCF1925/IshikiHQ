  occurrenceKey       String?
  allocationMethod    HouseholdAllocationMethod
  linkedTransactionId String?
  paidByMembershipId  String
  notes               String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  household         Household                    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy         User                         @relation("HouseholdExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  linkedTransaction Transaction?                 @relation(fields: [linkedTransactionId], references: [id], onDelete: SetNull)
  paidBy            HouseholdMembership          @relation("ExpensePayer", fields: [paidByMembershipId], references: [id], onDelete: NoAction)
  allocations       HouseholdExpenseAllocation[]
  recurringSource   HouseholdExpense?            @relation("HouseholdExpenseOccurrences", fields: [recurringSourceId], references: [id], onDelete: Restrict)
  occurrences       HouseholdExpense[]           @relation("HouseholdExpenseOccurrences")
  debtMovements     DebtMovement[]

  @@unique([recurringSourceId, occurrenceKey])
  @@index([householdId, incurredAt])
  @@index([createdById])
  @@index([linkedTransactionId])
  @@index([paidByMembershipId])
}

model HouseholdExpenseAllocation {
  id              String  @id @default(cuid())
  expenseId       String
  membershipId    String
  // Input weight (percentage, fixed amount or shares); allocatedAmount is the
  // immutable, currency-rounded result used for balances.
  value           Decimal @db.Decimal(14, 4)
  allocatedAmount Decimal @db.Decimal(14, 2)

  expense    HouseholdExpense    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  membership HouseholdMembership @relation(fields: [membershipId], references: [id], onDelete: NoAction)

  @@unique([expenseId, membershipId])
  @@index([membershipId])
}

model HouseholdSettlement {
  id                String   @id @default(cuid())
  householdId       String
  payerMembershipId String
  payeeMembershipId String
  amount            Decimal  @db.Decimal(14, 2)
  currency          String   @default("AUD")
  settledAt         DateTime
  note              String?
  createdById       String
  createdAt         DateTime @default(now())

  household Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  payer     HouseholdMembership @relation("SettlementPayer", fields: [payerMembershipId], references: [id], onDelete: NoAction)
  payee     HouseholdMembership @relation("SettlementPayee", fields: [payeeMembershipId], references: [id], onDelete: NoAction)
  debtMovements DebtMovement[]

  @@index([householdId, settledAt])
}

model HouseholdChore {
  id                         String    @id @default(cuid())
  householdId                String
  createdById                String
  title                      String
  description                String?
  recurrenceRule             String?
  rotationEnabled            Boolean   @default(false)
  rotationCursorMembershipId String?
  nextDueAt                  DateTime?
  archivedAt                 DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  household   Household                  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy   User                       @relation("HouseholdChoreCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignments HouseholdChoreAssignment[]
  completions HouseholdChoreCompletion[]

  @@index([householdId, archivedAt])
}

model HouseholdChoreAssignment {
  id            String   @id @default(cuid())
  choreId       String
  membershipId  String
  rotationOrder Int      @default(0)
  assignedAt    DateTime @default(now())

  chore      HouseholdChore      @relation(fields: [choreId], references: [id], onDelete: Cascade)
  membership HouseholdMembership @relation(fields: [membershipId], references: [id], onDelete: NoAction)

  @@unique([choreId, membershipId])
}

model HouseholdChoreCompletion {
  id            String   @id @default(cuid())
  householdId   String
  choreId       String
  membershipId  String
  completedById String
  completedAt   DateTime @default(now())
  occurrenceKey String?
  note          String?

  household  Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  chore      HouseholdChore      @relation(fields: [choreId], references: [id], onDelete: Cascade)
  membership HouseholdMembership @relation(fields: [membershipId], references: [id], onDelete: NoAction)

  @@unique([choreId, occurrenceKey])
  @@index([householdId, completedAt])
}

model HouseholdPet {
  id          String    @id @default(cuid())
  householdId String
  createdById String
  name        String
  species     String
  breed       String?
  dateOfBirth DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  household     Household                  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy     User                       @relation("HouseholdPetCreator", fields: [createdById], references: [id], onDelete: Restrict)
  careSchedules HouseholdPetCareSchedule[]
  appointments  HouseholdPetAppointment[]
  medications   HouseholdPetMedication[]
  costs         HouseholdPetCost[]

  @@index([householdId])
}

model HouseholdPetCareSchedule {
  id             String    @id @default(cuid())
  petId          String
  createdById    String
  title          String
  recurrenceRule String
  nextDueAt      DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  pet       HouseholdPet @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdBy User         @relation("HouseholdPetCareCreator", fields: [createdById], references: [id], onDelete: Restrict)
}

model HouseholdPetAppointment {
  id          String   @id @default(cuid())
  petId       String
  createdById String
  title       String
  startsAt    DateTime
  provider    String?
  location    String?
  cost        Decimal? @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime @default(now())

  pet       HouseholdPet @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdBy User         @relation("HouseholdPetAppointmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
}

model HouseholdPetMedication {
  id               String   @id @default(cuid())
  petId            String
  createdById      String
  name             String
  instructions     String?
  quantity         Decimal  @default(0) @db.Decimal(14, 3)
  reorderThreshold Decimal? @db.Decimal(14, 3)
  unit             String?
  unitCost         Decimal? @db.Decimal(14, 2)
  updatedAt        DateTime @updatedAt

  pet       HouseholdPet @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdBy User         @relation("HouseholdPetMedicationCreator", fields: [createdById], references: [id], onDelete: Restrict)
}

model HouseholdPetCost {
  id          String   @id @default(cuid())
  petId       String
  description String
  amount      Decimal  @db.Decimal(14, 2)
  incurredAt  DateTime
  createdById String
  createdAt   DateTime @default(now())

  pet       HouseholdPet @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdBy User         @relation("HouseholdPetCostCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([petId, incurredAt])
}

model HouseholdRecipe {
  id           String   @id @default(cuid())
  householdId  String
  createdById  String
  name         String
  description  String?
  instructions String?
  servings     Decimal? @db.Decimal(10, 2)
  prepMinutes  Int?
  cookMinutes  Int?
  notes        String?
  sourceUrl    String?
  importMethod HouseholdRecipeImportMethod?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  household   Household                   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy   User                        @relation("HouseholdRecipeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  ingredients HouseholdRecipeIngredient[]
  mealPlans   HouseholdMealPlan[]

  @@index([householdId, name])
  @@index([createdById])
}

model HouseholdRecipeIngredient {
  id          String   @id @default(cuid())
  householdId String
  recipeId    String
  createdById String
  name        String
  quantity    Decimal? @db.Decimal(14, 3)
  unit        String?
  notes       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipe    HouseholdRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdBy User            @relation("HouseholdRecipeIngredientCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([householdId, recipeId, sortOrder])
  @@index([createdById])
}

model HouseholdFoodInventory {
  id          String                @id @default(cuid())
  householdId String
  createdById String
  name        String

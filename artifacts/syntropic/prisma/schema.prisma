  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User      @relation("HouseholdFoodInventoryCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([householdId, location, expiresAt])
  @@index([createdById])
}

model HouseholdMealPlan {
  id          String   @id @default(cuid())
  householdId String
  createdById String
  recipeId    String?
  title       String
  plannedFor  DateTime
  mealType    String?
  servings    Decimal? @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipe    HouseholdRecipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  createdBy User             @relation("HouseholdMealPlanCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([householdId, plannedFor])
  @@index([recipeId])
  @@index([createdById])
}

model HouseholdShoppingListEntry {
  id          String   @id @default(cuid())
  householdId String
  createdById String
  name        String
  quantity    Decimal? @db.Decimal(14, 3)
  unit        String?
  checked     Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User      @relation("HouseholdShoppingEntryCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([householdId, checked, createdAt])
  @@index([createdById])
}

model HouseholdStorageLocation {
  id          String   @id @default(cuid())
  householdId String
  createdById String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household  Household                   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy  User                        @relation("HouseholdStorageLocationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  containers HouseholdStorageContainer[]
  items      HouseholdStorageItem[]

  @@index([householdId, name])
  @@index([createdById])
}

model HouseholdStorageContainer {
  id           String   @id @default(cuid())
  householdId  String
  createdById  String
  locationId   String
  name         String
  description  String?
  positionText String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  household    Household                     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  location     HouseholdStorageLocation      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdBy    User                          @relation("HouseholdStorageContainerCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items        HouseholdStorageItem[]
  qrReferences HouseholdStorageQrReference[]

  @@index([householdId, locationId, name])
  @@index([createdById])
}

model HouseholdStorageItem {
  id           String   @id @default(cuid())
  householdId  String
  createdById  String
  locationId   String
  containerId  String?
  name         String
  description  String?
  quantity     Decimal  @default(1) @db.Decimal(14, 3)
  unit         String?
  positionText String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  household    Household                     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  location     HouseholdStorageLocation      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  container    HouseholdStorageContainer?    @relation(fields: [containerId], references: [id], onDelete: SetNull)
  createdBy    User                          @relation("HouseholdStorageItemCreator", fields: [createdById], references: [id], onDelete: Restrict)
  labels       HouseholdStorageLabel[]
  qrReferences HouseholdStorageQrReference[]

  @@index([householdId, name])
  @@index([locationId])
  @@index([containerId])
  @@index([createdById])
}

model HouseholdStorageLabel {
  id          String   @id @default(cuid())
  householdId String
  itemId      String
  createdById String
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  item      HouseholdStorageItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdBy User                 @relation("HouseholdStorageLabelCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([itemId, value])
  @@index([householdId, value])
  @@index([createdById])
}

model HouseholdStorageQrReference {
  id          String   @id @default(cuid())
  householdId String
  itemId      String?
  containerId String?
  createdById String
  tokenHash   String   @unique
  createdAt   DateTime @default(now())

  household Household                  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  item      HouseholdStorageItem?      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  container HouseholdStorageContainer? @relation(fields: [containerId], references: [id], onDelete: Cascade)
  createdBy User                       @relation("HouseholdStorageQrCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([householdId, itemId])
  @@index([householdId, containerId])
  @@index([createdById])
}

// Append-only by application contract; resourceId and creator snapshots remain
// after a shared record or membership is removed.
model HouseholdAuditRecord {
  id            String               @id @default(cuid())
  householdId   String
  actorUserId   String
  action        HouseholdAuditAction
  resourceType  String
  resourceId    String?
  subjectUserId String?
  metadata      Json?
  createdAt     DateTime             @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, createdAt])
  @@index([resourceType, resourceId])
}

enum StudyRecordStatus {
  planned
  active
  completed
  withdrawn
  failed
  credited
  archived
}

enum StudyGradingMethod {
  percentage
  wam
  gpa4
  gpa7
  pass_fail
  competency
  custom
}

enum StudySuggestionStatus {
  pending
  approved
  rejected
}

model StudyProgram {
  id                     String             @id @default(cuid())
  userId                 String
  name                   String
  institution            String?
  code                   String?
  status                 StudyRecordStatus  @default(active)
  gradingMethod          StudyGradingMethod @default(percentage)
  startDate              DateTime?
  expectedEndDate        DateTime?
  calendarCategory       String?
  syncAssessmentCalendar Boolean            @default(false)
  syncDeadlineCalendar   Boolean            @default(false)
  notes                  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirements  StudyRequirement[]
  periods       StudyTeachingPeriod[]
  units         StudyUnit[]
  importBatches StudyUnitImportBatch[]
  gradingScales StudyGradingScale[]
  suggestions   StudyTaskSuggestion[]

  @@index([userId, status])
}

model StudyRequirement {
  id              String            @id @default(cuid())
  programId       String
  name            String
  type            String
  requiredCredits Decimal?          @db.Decimal(10, 2)
  status          StudyRecordStatus @default(planned)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  program StudyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  units   StudyUnit[]

  @@index([programId])
}

model StudyTeachingPeriod {
  id             String    @id @default(cuid())
  programId      String
  name           String
  startDate      DateTime
  endDate        DateTime
  censusDate     DateTime?
  withdrawalDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  program StudyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  units   StudyUnit[]

  @@index([programId, startDate])
}

model StudyUnit {
  id               String              @id @default(cuid())
  programId        String
  importBatchId    String?
  teachingPeriodId String?
  requirementId    String?
  code             String
  name             String
  creditPoints     Decimal?            @db.Decimal(10, 2)
  status           StudyRecordStatus   @default(planned)
  gradingMethod    StudyGradingMethod?
  finalValue       Decimal?            @db.Decimal(12, 4)
  finalOutcome     String?
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  program        StudyProgram         @relation(fields: [programId], references: [id], onDelete: Cascade)
  importBatch    StudyUnitImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  teachingPeriod StudyTeachingPeriod? @relation(fields: [teachingPeriodId], references: [id], onDelete: SetNull)
  requirement    StudyRequirement?    @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  assessments    StudyAssessment[]

  @@unique([programId, code])
  @@index([programId, status])
  @@index([importBatchId])
  @@index([teachingPeriodId])
}

model StudyUnitImportBatch {
  id        String     @id @default(cuid())
  programId String
  createdAt DateTime   @default(now())
  undoneAt  DateTime?

  program StudyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  units   StudyUnit[]

  @@index([programId, createdAt])
}

model StudyAssessment {
  id            String            @id @default(cuid())
  unitId        String
  name          String
  dueAt         DateTime?
  weight        Decimal?          @db.Decimal(7, 4)
  status        StudyRecordStatus @default(planned)
  resultValue   Decimal?          @db.Decimal(12, 4)
  resultOutcome String?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  unit        StudyUnit                  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  components  StudyAssessmentComponent[]
  suggestions StudyTaskSuggestion[]

  @@index([unitId, dueAt])
}

model StudyAssessmentComponent {
  id            String   @id @default(cuid())
  assessmentId  String
  name          String
  weight        Decimal? @db.Decimal(7, 4)
  maximumValue  Decimal? @db.Decimal(12, 4)
  achievedValue Decimal? @db.Decimal(12, 4)
  outcome       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assessment StudyAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

// Rules are explicit versioned snapshots. Calculations must name a scale;
// no conversion is inferred from the program's display method.
model StudyGradingScale {
  id            String             @id @default(cuid())
  userId        String
  programId     String?
  name          String
  method        StudyGradingMethod
  effectiveFrom DateTime
  effectiveTo   DateTime?
  maximumValue  Decimal?           @db.Decimal(12, 4)
  rules         Json
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  program StudyProgram? @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([userId, method, effectiveFrom])
  @@index([programId, effectiveFrom])
}

model StudyTaskSuggestion {
  id             String                @id @default(cuid())
  userId         String
  programId      String
  assessmentId   String?
  kind           String
  idempotencyKey String
  title          String
  dueAt          DateTime?
  status         StudySuggestionStatus @default(pending)
  taskId         String?
  eventId        String?
  createdAt      DateTime              @default(now())
  decidedAt      DateTime?

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  program    StudyProgram     @relation(fields: [programId], references: [id], onDelete: Cascade)
  assessment StudyAssessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
}

model PriceWatch {
  id                 String             @id @default(cuid())
  userId             String
  productName        String
  packQuantity       Float
  packUnit           String
  preferredRetailers String[]
  targetPrice        Float?
  checkCadence       String?
  status             String             @default("active")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  observations       PriceObservation[]

  @@unique([id, userId])
  @@index([userId, status])
}

model PriceObservation {
  id                   String     @id @default(cuid())
  userId               String
  watchId              String
  price                Float
  packQuantity         Float
  packUnit             String
  shippingCost         Float      @default(0)
  membershipAssumption String?
  sourceUrl            String?
  observedAt           DateTime
  notes                String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  watch                PriceWatch @relation(fields: [watchId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, watchId, observedAt])
}

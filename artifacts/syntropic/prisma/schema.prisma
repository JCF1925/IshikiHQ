enum HealthClaimImportKind {
  medicare
  private_health
}

enum HealthClaimImportStatus {
  review
  confirmed
  canceled
  rejected
}

// Account deletion erases confirmed claims and row payloads, but keeps this record as
// an ownership-detached tombstone so the import lifecycle remains auditable.
//
// Tombstone invariant: kind, status, contentType, byteSize, lifecycle timestamps, and
// deletedAt may remain as non-content lifecycle metadata. fileName, sha256,
// detectedFields, parseErrors, and storageKey must not retain source identifiers,
// parser output, hashes, or object references; the deletion flow replaces each with a
// fixed redaction marker or null. This is intentionally explicit so adding a field to
// this model cannot silently expand the retained health-data surface.
model HealthClaimImport {
  id             String                  @id @default(cuid())
  userId         String?
  kind           HealthClaimImportKind
  fileName       String
  contentType    String
  byteSize       Int
  sha256         String
  storageKey     String
  status         HealthClaimImportStatus @default(review)
  detectedFields Json?
  parseErrors    Json?
  confirmedAt    DateTime?
  canceledAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  user        User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  rows        HealthClaimImportRow[]
  auditEvents HealthClaimImportAudit[]

  @@unique([id, userId])
  @@unique([userId, sha256])
  @@index([userId, status])
}

model HealthClaimImportRow {
  id          String   @id @default(cuid())
  importId    String
  userId      String
  rowNumber   Int
  fingerprint String
  data        Json
  errors      Json?
  status      String   @default("valid") // valid, invalid, excluded, duplicate, confirmed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  import HealthClaimImport @relation(fields: [importId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Restrict)
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber])
  @@index([userId, fingerprint])
  @@index([importId, status])
}

enum HealthClaimImportAuditAction {
  source_uploaded
  import_rejected
  row_edited
  row_excluded
  row_included
  import_confirmed
  review_canceled
  source_removed
}

// Append-only review metadata. Never store claim values, request bodies, file contents,
// parser output, hashes, filenames, or storage references here. changedFields is limited
// to safe field-name metadata (or the boolean confirmation marker). Account deletion
// detaches both user references rather than deleting this history.
model HealthClaimImportAudit {
  id             String                       @id @default(cuid())
  importId       String
  userId         String?
  actorUserId    String?
  action         HealthClaimImportAuditAction
  rowNumber      Int?
  previousStatus String?
  nextStatus     String?
  changedFields  Json?
  createdAt      DateTime                     @default(now())

  import HealthClaimImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  user   User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  actor  User?             @relation("HealthClaimAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([importId, createdAt])
  @@index([userId, createdAt])
  @@index([actorUserId, createdAt])
}

// Cross-instance operational grouping state. This is deliberately limited to
